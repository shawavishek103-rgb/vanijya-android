<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vanijya" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Vanijya.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAF8F4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Theme.Vanijya</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
