<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="logo_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.85"
                android:scaleY="0.85">
                <!-- Rounded indigo-violet badge -->
                <path
                    android:fillColor="#FF3D2996"
                    android:pathData="M24,18 L84,18 A6,6 0 0,1 90,24 L90,84 A6,6 0 0,1 84,90 L24,90 A6,6 0 0,1 18,84 L18,24 A6,6 0 0,1 24,18 Z" />
                <!-- Left bar emerald -->
                <path
                    android:fillColor="#FF0FB57F"
                    android:pathData="M30,36 C30,33.5 32,31.5 34.5,31.5 L40.5,31.5 C42.5,31.5 44.2,32.8 44.8,34.7 L55.5,69.5 L46.2,76.5 C44.5,77.7 42.1,76.9 41.4,74.9 L30.3,37.8 C30.1,37.2 30,36.6 30,36 Z" />
                <!-- Right bar white -->
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M53.5,77.5 C51.2,77.5 49.4,75.3 50.1,73.1 L62.8,34.7 C63.4,32.8 65.1,31.5 67.1,31.5 L73.5,31.5 C76,31.5 78,33.5 78,36 C78,36.6 77.9,37.2 77.7,37.8 L63.2,74.7 C62.5,76.4 60.8,77.5 59.0,77.5 Z" />
                <!-- Gold dot -->
                <group
                    android:name="gold_dot"
                    android:pivotX="71"
                    android:pivotY="24">
                    <path
                        android:fillColor="#FFF2B134"
                        android:pathData="M71,24 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="logo_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
